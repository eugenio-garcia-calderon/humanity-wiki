{
  "name": "humanity-wiki",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node scripts/sellar-sw.mjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "start": "node dist/server.cjs",
    "probar:acciones": "node --env-file=.env scripts/probar-acciones-ia.mjs",
    "seguridad:permisos": "node scripts/auditar-permisos.mjs",
    "seguridad:probar": "tsx scripts/probar-politica.ts && tsx scripts/probar-clasificacion.ts && tsx scripts/probar-cifrado.ts && tsx scripts/probar-registro.ts",
    "seguridad:clasificacion": "node scripts/auditar-clasificacion.mjs",
    "probar:fotos": "node --env-file=.env node_modules/.bin/tsx scripts/probar-fotos.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "@stripe/stripe-js": "^9.12.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/mapbox-gl": "^3.5.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "geoip-lite": "^2.0.3",
    "html2canvas": "^1.4.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "mapbox-gl": "^3.27.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.2.108",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "playwright": "^1.62.1",
    "postprocessing": "^6.39.4",
    "pptxgenjs": "^4.0.1",
    "prop-types": "^15.8.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.1",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.10.1",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/geoip-lite": "^1.4.4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/react-simple-maps": "^3.0.6",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "@xyflow/system": {
      "d3-transition": "^3.0.1",
      "d3-selection": "^3.0.0"
    }
  }
}
