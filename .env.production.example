# ============================================================================
# humanity.wiki — variables de producción
# Copiar a `.env.production` EN EL SERVIDOR y rellenar. Este archivo de
# ejemplo sí se versiona; el real jamás (está en .gitignore).
# REGLA DE ORO: aquí solo claves de TEST de Stripe. Las claves LIVE aparcadas
# no salen del ordenador de Eugenio hasta la activación formal de pagos.
# ============================================================================

NODE_ENV=production
PORT=3000

# Base de datos (el host es el servicio `db` del docker-compose)
SQL_HOST=db
SQL_DB_NAME=humanity
SQL_ADMIN_USER=humanity
SQL_ADMIN_PASSWORD=CAMBIA-ESTO-password-larga-y-unica

# IA (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Stripe — SOLO claves de test (sk_test_/pk_test_)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudflare (gestión de DNS/caché desde scripts, opcional en el servidor)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=5ef47a1bd5975ceb5f5410d079c3d4a0

# Login con Google
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Mapbox (variable de BUILD de Vite: docker-compose la pasa como build-arg,
# se incrusta en el bundle del frontend al compilar la imagen)
VITE_MAPBOX_TOKEN=pk.xxxxx

# ============================================================================
# Copias de seguridad FUERA de Hetzner (servicio `copias-remoto`)
# ============================================================================
# Sin esto, el volcado diario se hace igual pero se queda en el mismo servidor:
# protege del error humano, no de perder la máquina o la cuenta.
#
# Pensado para Cloudflare R2 (mismo panel que el DNS, 10 GB gratis, sin coste
# de salida), pero vale cualquier almacenamiento compatible con S3: cambia
# PROVEEDOR y ENDPOINT. Cómo se saca cada dato: deploy/copias/CLAUDE.md
#
# La clave debe poder ESCRIBIR y LEER solo este cubo. Nada más.
# COPIAS_REMOTO_CUBO=humanity-copias
# COPIAS_REMOTO_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com
# COPIAS_REMOTO_CLAVE_ID=
# COPIAS_REMOTO_CLAVE_SECRETA=
# COPIAS_REMOTO_PROVEEDOR=Cloudflare
