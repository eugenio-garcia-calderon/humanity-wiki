# ============================================================================
# humanity.wiki — variables de producción
# Copiar a `.env.production` EN EL SERVIDOR y rellenar. Este archivo de
# ejemplo sí se versiona; el real jamás (está en .gitignore).
# REGLA DE ORO: aquí solo claves de TEST de Stripe. Las claves LIVE aparcadas
# no salen del ordenador de Eugenio hasta la activación formal de pagos.
# ============================================================================

NODE_ENV=production
PORT=3000

# Base de datos (el host es el servicio `db` del docker-compose)
SQL_HOST=db
SQL_DB_NAME=humanity
SQL_ADMIN_USER=humanity
SQL_ADMIN_PASSWORD=CAMBIA-ESTO-password-larga-y-unica

# IA (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Stripe — SOLO claves de test (sk_test_/pk_test_)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudflare (gestión de DNS/caché desde scripts, opcional en el servidor)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=5ef47a1bd5975ceb5f5410d079c3d4a0

# Login con Google
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Mapbox (variable de BUILD de Vite: docker-compose la pasa como build-arg,
# se incrusta en el bundle del frontend al compilar la imagen)
VITE_MAPBOX_TOKEN=pk.xxxxx
