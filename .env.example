VITE_MAPBOX_TOKEN=
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# ── LLAMADAS: EL SERVIDOR DE RETRANSMISIÓN (TURN) ───────────────────────────
# Solo hace falta para las llamadas que NO encuentran camino directo: entre un
# 10 % y un 15 %, las que salen de redes de empresa o de algunas redes móviles.
# Sin estas dos líneas todo lo demás funciona; esas llamadas concretas no
# conectan y la aplicación lo dice con esas palabras.
#
# Se sacan de: panel de Cloudflare → Realtime → TURN → crear una clave.
# La segunda es un secreto: NUNCA se copia a `memory/` ni se imprime.
# Precio (consultado el 2026-08-22): los primeros 1.000 GB de salida al mes son
# gratis, después 0,05 $/GB. Una hora de videollamada retransmitida ronda 1 GB;
# una de voz, 45 MB. `GET /api/telecom/gasto` dice cuánto se lleva gastado.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Alternativa: un `coturn` propio en el mismo servidor. Si están las dos de
# arriba, mandan ellas y estas se ignoran.
TURN_URL=
TURN_USUARIO=
TURN_CLAVE=

# ── CIFRADO DE DATOS SENSIBLES ──────────────────────────────────────────────
# La llave maestra con la que se envuelven las llaves de cada dato cifrado
# (`src/server/seguridad/cifrado.ts`). Hoy la usa la conexión con Google para
# guardar el permiso duradero de cada persona.
#
# Se genera una vez con:  openssl rand -base64 32
#
# NO SE ROTA A LA LIGERA: al cambiarla, todo lo cifrado con la anterior deja de
# poder leerse. En el caso de Google eso significa que todo el mundo tendría que
# volver a conectar su cuenta — se avisa solo en pantalla, pero es una molestia
# para cada persona.
CLAVE_MAESTRA=

# ── CONECTAR UNA CUENTA DE GOOGLE ───────────────────────────────────────────
# NO es lo mismo que «entrar con Google». Esto es el permiso duradero que deja a
# la plataforma pedirle a Google los vídeos, los contactos y el calendario de
# quien lo conceda. Por eso necesita un SECRETO de cliente, que el de entrar no
# necesitaba.
#
# Se sacan de: consola de Google Cloud → APIs y servicios → Credenciales →
# ID de cliente de OAuth (tipo «aplicación web»).
#
# En «URI de redirección autorizados» hay que dar de alta EXACTAMENTE:
#   https://humanity.wiki/api/google/vuelta
# y, para desarrollo, la que uses en local.
#
# Sin estas dos, la conexión con Google no se ofrece siquiera: la pantalla dice
# que no está disponible en vez de enseñar un botón que va a fallar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Solo si la dirección de vuelta no se puede deducir del propio servidor.
GOOGLE_REDIRECT_URI=
